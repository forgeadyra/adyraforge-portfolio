# Backend settings. Copy to backend/.env and fill in. Placeholders only: no real values here.
#
# DJANGO_ENV: development | production | test | maintenance. Unset or unknown =>
# production (fails closed). maintenance = management commands from GitHub Actions only.
DJANGO_ENV=development

# Required in every environment. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated, no wildcards. Production: only the Render service host,
# e.g. <service>.onrender.com (the browser reaches it via the site's /api proxy).
# "backend" lets the frontend container's middleware reach the API in Docker.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL only. docker compose sets this for you from the root .env;
# set it here only when running Django outside Docker.
# DATABASE_URL=postgres://adyraforge:password@localhost:5432/adyraforge

# Admin path. Production requires an unguessable path of 16+ chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(18) + '/')"
ADMIN_URL=admin/

# Exact frontend origins (production: https://adyraforge.netlify.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend origin used in emailed invite/reset links and to check Turnstile's
# hostname (production: https://adyraforge.netlify.app). Domain changes are env-only.
FRONTEND_URL=http://localhost:3000

# Mail (SMTP). Development always prints emails to the backend log (console
# backend), so these can stay empty locally. Production requires host, user,
# password, TLS, a sender and a lead address. Production uses Gmail:
# smtp.gmail.com / 587 / TLS, user = the Gmail address, password = a Gmail APP
# PASSWORD (never the account password), sender = the same Gmail address.
# Real values go in the Render dashboard only.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AdyraForge <noreply@example.com>
LEAD_NOTIFY_EMAIL=

# Cloudflare Turnstile secret. Cloudflare publishes test keys for development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Production refuses to boot with a test key.
TURNSTILE_SECRET_KEY=

# Reverse proxies on the DIRECT path that append to X-Forwarded-For.
# 0 locally (X-Forwarded-For is ignored). Render: 1. Production refuses to boot unset.
# Wrong values break per-IP throttles and lockouts (too high = spoofable IPs).
TRUSTED_PROXY_COUNT=0

# Shared with Netlify (env var of the same name, Runtime scope): Netlify signs every
# /api proxy request with it, and only signed requests may name the client IP via
# X-Nf-Client-Connection-Ip. Production requires 32+ chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NETLIFY_PROXY_SIGNING_SECRET=

# Leave SESSION_COOKIE_DOMAIN unset: cookies are host-only on the site's own domain
# (the browser reaches the API through the site's /api proxy).

# Public media base URL (absolute). Dev: the API origin. Production: the https://
# public URL of MEDIA_BUCKET on Backblaze B2 (required), e.g.
# https://<MEDIA_BUCKET>.s3.<region>.backblazeb2.com/
MEDIA_URL=http://localhost:8000/media/

# Upload storage. Development keeps files on disk and ignores these. PRODUCTION
# REQUIRES the first four (with MEDIA_URL above) and refuses to boot without them:
# uploads must never live on the container disk. Placeholders only; real values go
# in the Render dashboard. PRIVATE_BUCKET must differ from MEDIA_BUCKET.
# PRIVATE_BUCKET=adyraforge-private
# MEDIA_BUCKET=adyraforge-media
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Backblaze B2 (S3-compatible): endpoint and region are shown on the bucket page,
# e.g. https://s3.us-west-004.backblazeb2.com and us-west-004.
# Any S3-compatible provider works the same way (AWS: leave the endpoint empty).
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=

# Optional
# CACHE_URL=dbcache://django_cache
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# LOG_LEVEL=INFO
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_LOGIN=5/min
# THROTTLE_PASSWORD_RESET=3/hour
# THROTTLE_CONTACT=5/hour
# THROTTLE_PLANNER=10/hour
