# Backend settings. Copy to backend/.env and fill in. Placeholders only: no real values here.
#
# DJANGO_ENV: development | production | test. Unset or unknown => production (fails closed).
DJANGO_ENV=development

# Required in every environment. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated, no wildcards in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL only. docker compose sets this for you from the root .env;
# set it here only when running Django outside Docker.
# DATABASE_URL=postgres://adyraforge:password@localhost:5432/adyraforge

# Admin path. Production requires an unguessable path of 16+ chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(18) + '/')"
ADMIN_URL=admin/

# Exact frontend origins (production: https://adyraforge.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Optional
# CACHE_URL=dbcache://django_cache
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# LOG_LEVEL=INFO
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_LOGIN=5/min
# THROTTLE_PASSWORD_RESET=3/hour
# THROTTLE_CONTACT=5/hour
# THROTTLE_PLANNER=10/hour
