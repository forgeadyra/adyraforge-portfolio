# Backend settings. Copy to backend/.env and fill in. Placeholders only: no real values here.
#
# DJANGO_ENV: development | production | test. Unset or unknown => production (fails closed).
DJANGO_ENV=development

# Required in every environment. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Comma-separated, no wildcards in production.
# "backend" lets the frontend container's middleware reach the API in Docker.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL only. docker compose sets this for you from the root .env;
# set it here only when running Django outside Docker.
# DATABASE_URL=postgres://adyraforge:password@localhost:5432/adyraforge

# Admin path. Production requires an unguessable path of 16+ chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(18) + '/')"
ADMIN_URL=admin/

# Exact frontend origins (production: https://adyraforge.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend origin used in emailed invite/reset links (production: https://adyraforge.com).
FRONTEND_URL=http://localhost:3000

# Mail (SMTP). Development always prints emails to the backend log (console
# backend), so these can stay empty locally. Production requires host, user,
# password and TLS. Put real values in backend/.env / the Render dashboard only.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AdyraForge <noreply@example.com>
LEAD_NOTIFY_EMAIL=

# Cloudflare Turnstile secret. Cloudflare publishes test keys for development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Production refuses to boot with a test key.
TURNSTILE_SECRET_KEY=

# Reverse proxies in front of Django that append to X-Forwarded-For.
# 0 locally (X-Forwarded-For is ignored). Render: 1. Production refuses to boot unset.
# Wrong values break per-IP throttles and lockouts (too high = spoofable IPs).
TRUSTED_PROXY_COUNT=0

# Production, same-site cookies across adyraforge.com and api.adyraforge.com
# (needed so Next middleware sees the session): SESSION_COOKIE_DOMAIN=.adyraforge.com

# Public media base URL (absolute). Dev: the API origin. Production: the https://
# public origin of MEDIA_BUCKET, e.g. https://media.adyraforge.com/ (required).
MEDIA_URL=http://localhost:8000/media/

# Upload storage. Development keeps files on disk and ignores these. PRODUCTION
# REQUIRES the first four (with MEDIA_URL above) and refuses to boot without them:
# uploads must never live on the container disk. Placeholders only; real values go
# in the Render dashboard. PRIVATE_BUCKET must differ from MEDIA_BUCKET.
# PRIVATE_BUCKET=adyraforge-private
# MEDIA_BUCKET=adyraforge-media
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com and region "auto".
# AWS S3: leave the endpoint empty and set the bucket region.
# STORAGE_ENDPOINT_URL=
# STORAGE_REGION=auto

# Optional
# CACHE_URL=dbcache://django_cache
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# LOG_LEVEL=INFO
# THROTTLE_ANON=60/min
# THROTTLE_USER=240/min
# THROTTLE_LOGIN=5/min
# THROTTLE_PASSWORD_RESET=3/hour
# THROTTLE_CONTACT=5/hour
# THROTTLE_PLANNER=10/hour
