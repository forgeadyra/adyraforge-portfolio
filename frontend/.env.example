# Copy to .env.local for `npm run dev` outside Docker.
# Only NEXT_PUBLIC_* reaches the browser, and none of these may ever be secret.

# Django API origin. Production: https://api.adyraforge.com (must be https).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin (metadata, sitemap, JSON-LD). Production: https://adyraforge.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public). Cloudflare publishes test keys for development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: public media origin (Cloudinary/S3). Defaults to the API origin.
# NEXT_PUBLIC_MEDIA_URL=https://res.cloudinary.com

# Server-only: where Next middleware reaches the API (Docker: http://backend:8000).
# Defaults to NEXT_PUBLIC_API_URL. Not exposed to the browser.
# API_INTERNAL_URL=http://backend:8000

# CI only: build without a reachable API (empty ISR pages). Never set in a deploy.
# NEXT_BUILD_WITHOUT_API=1
