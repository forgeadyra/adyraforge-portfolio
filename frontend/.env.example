# Copy to .env.local for `npm run dev` outside Docker.
# Only NEXT_PUBLIC_* reaches the browser, and none of these may ever be secret.
# Production values are set in the Netlify UI (DEPLOY.md), never in netlify.toml,
# so moving to a custom domain later is an env change only.

# Server-only: where the Next server (build, ISR, middleware) and the same-origin
# /api proxy reach Django. Docker: http://backend:8000. Production: the Render
# service URL, e.g. https://<service>.onrender.com. Never sent to the browser.
API_INTERNAL_URL=http://localhost:8000

# Canonical public origin (metadata, sitemap, robots, JSON-LD).
# Production: https://adyraforge.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public media origin. Development: the API (Django serves /media). Production: the
# Backblaze B2 public bucket's S3 host, e.g. https://<bucket>.s3.<region>.backblazeb2.com
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000

# Cloudflare Turnstile site key (public). Cloudflare publishes test keys for development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Sentry DSN (a public identifier, not a secret).
# NEXT_PUBLIC_SENTRY_DSN=

# CI only: build without a reachable API (empty ISR pages). Never set in a deploy.
# NEXT_BUILD_WITHOUT_API=1
